# Copie para backend/.env e ajuste.
# A API precisa conectar com um usuário SEM superuser e SEM BYPASSRLS.
DATABASE_URL=postgresql+psycopg://atendeja:atendeja@localhost:5432/atendeja
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-esta-chave
COOKIE_SECURE=false
# COOKIE_DOMAIN=.atendeja.com.br
CORS_ORIGINS=["http://localhost:5173"]

# Página pública: ligar só quando a API estiver atrás de proxy (Render/Railway/Cloudflare)
TRUST_PROXY_HEADERS=false
